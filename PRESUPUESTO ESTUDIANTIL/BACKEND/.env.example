# ========================================================
# CONFIGURACIÓN DE ENTORNO - BACKEND FASTAPI
# ========================================================

# Conexión a PostgreSQL:
# Formato: postgresql+psycopg2://<usuario>:<password>@localhost:5432/<nombre_bd>
DATABASE_URL=postgresql+psycopg2://postgres:TU_CONTRASEÑA@localhost:5432/presupuesto_estudiantil

# Clave secreta para firmar tokens JWT
SECRET_KEY=cambia_esta_clave_secreta
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Envío de correos (código de recuperación de contraseña)
# Con Gmail: SMTP_USER es tu correo y SMTP_PASSWORD una "contraseña de aplicación" de 16 letras
# (myaccount.google.com/apppasswords). Si se dejan vacíos, el código se muestra en la consola del backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Presupuesto Estudiantil
